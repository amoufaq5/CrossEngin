{
  "name": "crossengin",
  "version": "0.0.0",
  "description": "CrossEngin — AI-native application platform",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/amoufaq5/CrossEngin"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && sh .githooks/install-hooks.sh || true",
    "build": "turbo run build",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23",
      "brace-expansion@^1": "^1.1.22",
      "brace-expansion@^5": "^5.0.13",
      "js-yaml@^4": "^4.3.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-587h-7wmj-h5pm",
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-5xrq-8626-4rwp",
        "GHSA-85c8-ppgw-ccpr",
        "GHSA-fc5q-39xc-vjpf",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
