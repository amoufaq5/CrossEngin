# Automatic HTTPS (Let's Encrypt) for the UI and the API. Requires DNS A/AAAA
# records for both {$DOMAIN} and api.{$DOMAIN} pointing at this VM, ports 80+443 open.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# The admin/operator web UI.
{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy web:3000
}

# The API directly — for integrations, webhooks, and JWT clients. The browser UI
# does NOT use this; it talks to the web app's own /api proxy over the internal net.
api.{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:8787
}
