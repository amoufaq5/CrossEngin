# Copy to deploy/.env and fill in. Never commit deploy/.env (it holds secrets).

# --- Postgres ---------------------------------------------------------------
# All three are read by BOTH the `db` and `extensions`/`migrate`/`api` services:
# `db` creates that role and database at initdb time, and everything else
# connects as it.
#
# TWO THINGS ABOUT THE PASSWORD, because each produces the same failure and the
# message does not say which:
#
#   psql: error: connection to server at "db" ... failed:
#   FATAL:  password authentication failed for user "crossengin"
#
# 1. IT IS BAKED IN AT FIRST `up`, AND ONLY THEN. Postgres uses this value once,
#    to create the role in a fresh data directory. Changing it afterwards does
#    NOT change the role's password -- the `db-data` volume still holds a cluster
#    created with the old one, so every other service starts failing to connect
#    while `db` itself reports healthy. Either put the old value back, or destroy
#    the database:
#      docker compose down && docker volume rm crossengin_db-data
#    (That erases the database. It does NOT touch `crossengin_caddy-data`, which
#    is deliberate -- `down -v` would, and re-issuing the certificate counts
#    against Let's Encrypt's duplicate-certificate limit of 5 per week.)
#
# 2. `$` AND `#` ARE NOT LITERAL HERE. Compose interpolates `$NAME` in this file,
#    so `pa$$word` silently becomes `pa` plus two empty variables -- it prints a
#    "variable is not set" warning that scrolls past in a build log -- and `#`
#    begins a comment, truncating the rest. Quotes are kept literally by some
#    parsers and stripped by others, so do not use those either.
#
# Use hex and avoid the question entirely:
#   openssl rand -hex 24
POSTGRES_USER=crossengin
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=crossengin

# --- Public domain ----------------------------------------------------------
# DNS A/AAAA records for BOTH of these must point at this VM (ports 80+443 open):
#   <DOMAIN>       -> the web UI
#   api.<DOMAIN>   -> the API
DOMAIN=erp.example.com
ACME_EMAIL=ops@example.com

# --- Which vertical pack the API serves -------------------------------------
# erp-core | erp-retail | erp-healthcare | erp-grocery | erp-construction | ...
OPERATE_PACK=erp-core

# --- Auth -------------------------------------------------------------------
# The full API-key binding the server trusts:
#   "<token>:<role>:<tenant-uuid>[:<user-uuid>]"
# Use the platform_admin role + any placeholder tenant uuid to unlock /v1/platform
# (the tenant-management console). Generate a strong random <token>.
#
# The optional 4th field is the principal's meta.users.id. The notification inbox
# (GET /v1/meta/notifications) is per-recipient: it returns what was actually
# delivered to that person. A key with no user id resolves to nobody and gets an
# EMPTY inbox — correct for this bootstrap key, which is a platform operator and
# not a tenant user, but add the 4th field to any key that belongs to a real
# person or their /setup page will look broken.
# The compose file passes this through the API's `environment:` block as
# OPERATE_API_KEY_SPECS and NOT as `--api-key`, because the <token> is a
# credential and a process's argv is readable by anyone who can run `ps`
# (ADR-0301). The variable takes several specs separated by newlines or commas,
# so a second operator is another line here rather than another flag. The boot
# log says where the specs came from; if it mentions argv, something is still
# passing `--api-key`.
OPERATE_ADMIN_API_KEY=REPLACE_WITH_STRONG_TOKEN:platform_admin:00000000-0000-4000-8000-000000000000

# --- The UI's login (required) -----------------------------------------------
# OPERATE_WEB_API_KEY is GONE. The web app used to send one shared
# platform_admin token on every request, so every browser that could reach
# <DOMAIN> was that principal; it now authenticates each person and forwards
# their own session token. The variable is removed rather than left unset,
# because the proxy's old `?? "devkey"` default meant deleting it did not fail
# closed.
#
# Both of these are read from the environment and never from the command line
# (ADR-0301), and both are REQUIRED now that the UI has a login.
#
# The pepper is HMAC'd into a password before scrypt stretches it. It matters
# because `meta.users` carries no tenant_id and therefore no RLS, so the
# password hashes are readable by anything holding the serving role's grant —
# the pepper is what makes reading that table insufficient, precisely because it
# is not in the database. Same floors as the two secrets below (32+ bytes, 16+
# distinct values) and the same placeholder refusal: leaving the value below as
# it ships is REFUSED at boot, because the placeholder passes both floors and is
# in a public repository, which until ADR-0377 meant a deployment that replaced
# only the one secret the binary happened to reject ran on a published pepper
# against a `meta.users` that has no RLS to fall back on. Generate it with the
# line above.
#
# Changing it makes every existing password unverifiable, so every user needs a
# new one — which is the cost of fixing a deployment that is already running on
# the placeholder, and is the reason to set it correctly the first time.
CREDENTIAL_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# The Ed25519 seed this deployment signs session tokens with — 32 bytes of
# base64:
#
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
#
# ONE variable, not a pair: the public half is derived from the seed and
# registered in the gateway's own JWKS, so there is nothing to keep in step and
# no way for the two to disagree. Changing it invalidates every session in
# flight, which costs each user one 401 and a re-login.
OPERATE_TOKEN_SIGNING_KEY=REPLACE_WITH_32_BYTES_OF_BASE64

# THE BOOTSTRAP IS FOUR HTTP CALLS AND NO SHELL. This block used to open "the
# first user is a shell step, once", and gave the reason as: the console sets a
# password over HTTP and reaching that route needs a session, which needs a
# password. That reasoning expired. `POST /v1/platform/users/{id}/credential` is
# authorised by a GRANT — `--credential-admin-role platform_admin`, which the
# compose file passes — and the credential that satisfies it is the api-key
# you are about to create two variables above, not a session. Measured: the call
# in step 4 below answers 200 with `x-api-key` alone on a deployment with no
# password anywhere in it. `set-credential` is still there and is still the
# answer for a deployment that grants no credential-admin role; it is no longer
# the answer for this one.
#
# It is also FIVE steps, not four. Every version of this block has omitted the
# first one — creating the tenant — and without it step 3 is a 422 on every
# fresh deployment: `cannot grant a membership: meta.tenants has no row for the
# id this grant names`. There was no `<tenant-uuid>` to put in that path.
#
# Run these ON THE VM. They reach the API at 127.0.0.1:8787, which the compose
# file publishes on the loopback interface for exactly this purpose — so the
# bootstrap does not depend on DNS having propagated or on Caddy holding a
# certificate yet. From anywhere else the same requests go to
# https://api.<DOMAIN>, the same API through Caddy. Until that loopback publish
# landed the commands below named a port the stack published nowhere, so the
# only documented path to the first login could not be followed as written.
#
#   1. create the tenant. The body is {slug, name} and the ID IS MINTED BY THE
#      SERVER — `id` is not an accepted key and sending one is a 400
#      (`unrecognized_keys`). So the uuid in OPERATE_ADMIN_API_KEY above can
#      never name a real tenant, which is why that comment calls it a
#      placeholder and why /v1/platform is exempt from the tenant-status gate.
#        curl -X POST http://localhost:8787/v1/platform/tenants \
#          -H "x-api-key: <the token half of OPERATE_ADMIN_API_KEY>" \
#          -H 'content-type: application/json' \
#          -d '{"slug":"acme","name":"Acme"}'
#
#      Keep the `tenant.id` it returns: steps 3 and 5 both name it, and the
#      `slug` is what step 5 logs in with.
#
#   2. create the user (needs --platform-user-routes on the api command)
#        curl -X POST http://localhost:8787/v1/platform/users \
#          -H "x-api-key: <the token half of OPERATE_ADMIN_API_KEY>" \
#          -H 'content-type: application/json' \
#          -d '{"user":{"email":"you@example.com","displayName":"You"}}'
#
#      Note the body is NESTED under "user" — the schema is {user, membership?}
#      and it is parsed strictly, so the flat form this file used to show was a
#      400 every time. `membership` is optional here and step 3 is the same
#      thing done separately.
#
#   3. grant it a membership in that tenant, which is what decides the role every
#      session of theirs will carry. The tenant is in the PATH and must not also
#      be in the body (the schema omits it and is strict):
#        curl -X POST http://localhost:8787/v1/platform/tenants/<tenant-id-from-step-1>/members \
#          -H "x-api-key: <the token half of OPERATE_ADMIN_API_KEY>" \
#          -H 'content-type: application/json' \
#          -d '{"userId":"<the id from step 2>","primaryRole":"platform_admin","status":"active"}'
#
#      `status` has NO default: "invited" promises access and "active" grants it,
#      and only an active membership resolves as a notification recipient.
#
#      On `primaryRole`: a session carries exactly the roles this membership
#      names, and `platform_admin` is NOT one of erp-core's fifteen declared
#      roles — measured, it reaches 0 of 255 (entity, operation) pairs, so this
#      login administers tenants and users and can read no ERP data at all
#      (`GET /v1/vendors` is a 403). That is the right role for the operator who
#      runs these commands. For somebody who is meant to USE the ERP, name an
#      erp-core role (`erp_admin` reaches 250 of 255), and add
#      `--read-state-role <that role>` to the api command so their inbox badge
#      is answered rather than approximated.
#
#   4. set the password — over HTTP, with the same api-key
#        curl -X POST http://localhost:8787/v1/platform/users/<the id from step 2>/credential \
#          -H "x-api-key: <the token half of OPERATE_ADMIN_API_KEY>" \
#          -H 'content-type: application/json' \
#          -d '{"confirmUserId":"<the same id>","password":"<password>"}'
#
#      The id is typed twice on purpose: this overwrites a credential, so naming
#      the wrong user both locks that person out and hands their account to
#      whoever chose the password. The route refuses the caller's own id
#      (`self_not_permitted`) — changing your own password is /account, which
#      proves possession of the current one instead.
#
#   5. log in. The body is {tenant, email, password} and `tenant` is the SLUG or
#      the id from step 1 — not a header, and not the placeholder uuid:
#        curl -X POST http://localhost:8787/v1/auth/token \
#          -H 'content-type: application/json' \
#          -d '{"tenant":"acme","email":"you@example.com","password":"<password>"}'
#
#      It answers {token, expiresAt, tenantId, role, secondaryRoles}. The browser
#      does this for you at https://<DOMAIN>/login; the curl is here so a failure
#      can be read without the UI in the way.
#
# After that, do the rest in the console: Platform → Tenants provisions tenants
# and grants memberships, Platform → Users provisions people and sets their first
# password, and each person changes their own password at /account. None of those
# needs a shell either.

# --- At-rest and cursor encryption -------------------------------------------
# Both are read from the environment and never from the command line, and both
# derive a per-tenant key with HKDF-SHA256 rather than storing one. Each needs
# at least 32 bytes and at least 16 distinct byte values — a secret that is long
# and uniform ("aaaa...") is refused, because that is the shape a deployment
# produces when it is satisfying a length check rather than supplying entropy.
#
# ONE OF THEM IS COMMENTED OUT AND ONE IS NOT, and the asymmetry is measured on
# the pack this file serves rather than chosen: resolved erp-core declares
# **0** `phi`/`regulated` fields and **1** classified field that a list view can
# sort by. So the at-rest secret is genuinely not needed here and the cursor
# secret is. They were both commented out until ADR-0376, which is how the
# canonical quickstart came to be the one deploy document that leaves the cursor
# unsealed while `ORACLE.md`, `README.md` and `VERCEL-SUPABASE.md` all treat it
# as required.
#
# Needed by a manifest that classifies a field `phi` or `regulated`, on
# `--store pg-columns`. erp-core declares none; erp-healthcare and
# erp-government do, and booting either without this is REFUSED rather than
# served in the clear. Changing it makes every existing ciphertext unreadable.
#COLUMN_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# REQUIRED on this stack. Seals the entity-list keyset cursor (AES-256-GCM).
# Unsealed, a cursor is reversible base64url JSON carrying the plaintext of
# every declared sort key — so `?sort=<classified field>` returns in
# `nextCursor` exactly what the response body redacted from the same caller, and
# `?fields=id&limit=1` isolates it one value per request. Measured on the
# shipped default: `Employee.work_email` (pii) is sortable, and two callers who
# differ only in that field's read grant receive a BYTE-IDENTICAL cursor.
#
# There is no per-caller fix downstream of the store, which is why this is a
# secret rather than a patch: the gateway's redactor matches KEY NAMES, so a
# classified value inside a string under a key called `nextCursor` is invisible
# to it by construction, and the caller's redaction set is not computed until
# after the handler has returned.
#
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
#
# RUN THAT LINE. Leaving the placeholder below is REFUSED at boot
# (`unreplaced_placeholder`) and the refusal prints that command. It has to be,
# and the reason is worth knowing because it is not the obvious one: the
# placeholder is 33 bytes with 19 distinct values, so it passes both of the
# entropy floors these secrets are checked against — it is strong and it is
# *public*. Without the refusal, uncommenting this line would have turned a true
# `[cursor] cursor disclosure: plaintext_disclosing` warning naming the exact
# field into a confident `sealed` asserting "none of their values travels back in
# the clear", with every cursor sealed under a key derivable from this file. A
# control that reports success it has not got is worse than no control.
#
# Rotating it invalidates cursors in flight, which costs a client one 400 and a
# restarted page walk. Once set, the boot line is `[cursor] cursor sealing: sealed`.
CURSOR_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# --- In-product AI Architect (optional) --------------------------------------
# Tenants describe their business at /setup in the UI and review the generated
# system. They cannot activate it on their own: the compose passes
# `--require-design-review`, so Activate answers 403 `review_required` until a
# platform_admin approves the proposal at Platform -> Design Reviews. An
# activated manifest MERGES OVER this deployment's pack rather than replacing
# it. Both of those are new in ADR-0368 — see "Approving a tenant's design" in
# README.md before the first one arrives, because the diff you approve covers
# five of the manifest's sixteen sections.
#
# Two ways to run it:
#
# A) HOSTED MODEL — cheapest, no GPU. `--ai-design` is already on the api
#    command, so this needs no compose edit: set ONE of the two keys below and
#    restart the api. Until one is set the routes mount and POST /v1/ai/design
#    answers 503, with `[ai-design] no AI provider configured` at boot.
#
#    Precedence is local → Anthropic → OpenAI, so if you also set a local base
#    URL for (B) the key here is ignored. A local base URL that is set but
#    MALFORMED refuses outright rather than falling back to a cloud vendor —
#    deliberately, so a stray key cannot send a tenant's business description
#    somewhere the operator opted out of.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# B) SELF-HOSTED MODEL — nothing leaves the VM. Needs no edits to the compose
#    command; bring it up with the AI overlay instead:
#      docker compose -f docker-compose.yml -f docker-compose.ai.yml up -d --build
#    (add -f docker-compose.ai-gpu.yml on a GPU host). Tune it with:
#
# The model Ollama pulls and the API asks for. Must be a real Ollama tag.
# Needs to follow instructions and emit strict JSON — a small model will fail to
# produce a valid manifest however fast it is.
OPERATE_AI_MODEL=qwen2.5:14b-instruct

# Optional. Ollama needs no key and the provider omits the header when this is
# empty; a vLLM box behind an auth proxy needs one. Not a secret for Ollama.
OPERATE_AI_API_KEY=

# --- Email and SMS delivery (optional) ---------------------------------------
# Without these, only in-app notices are delivered: every email or SMS dispatch is
# refused as `no_sender_configured`, which the drain treats as retryable — so
# configuring a channel later delivers the backlog rather than losing it. Needs
# `--notification-drain-ms <n>` on the api command, or nothing is drained at all.
#
# These are credentials, which is why they are here and not CLI flags: a process's
# argv is readable by anyone who can run `ps` (ADR-0301).
#
# Note: an unset variable here falls through to the host's own environment, which
# is usually what you want on a host with AWS credentials already exported — but it
# also means a stray AWS_ACCESS_KEY_ID in the shell registers a real sender. The
# boot log lists the channels it registered, so check it after the first `up`.
#
# Amazon SES. All four are required together; a partial set is ignored with a
# warning rather than guessed. SES_CONFIGURATION_SET is what makes bounces
# reachable — without it, a hard-bounced address is retried forever.
#SES_REGION=eu-west-1
#SES_FROM_ADDRESS=notices@example.com
#SES_FROM_NAME=Acme Notices
#SES_CONFIGURATION_SET=crossengin-events
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
# Override the endpoint for a VPC interface endpoint or an egress proxy.
#SES_ENDPOINT_URL=

# Twilio. Needs the account SID, one credential pair (an API key is preferred
# over the account's root auth token — it is revocable on its own), and one
# sender identity. Setting both sender identities uses the messaging service.
#TWILIO_ACCOUNT_SID=
#TWILIO_API_KEY_SID=
#TWILIO_API_KEY_SECRET=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=+15555550100
#TWILIO_MESSAGING_SERVICE_SID=
# Twilio reports carrier failures only to a status callback, so without one a
# number that has stopped accepting messages never produces a suppression.
#TWILIO_STATUS_CALLBACK_URL=https://api.example.com/v1/notifications/bounces
#TWILIO_BASE_URL=

# --- Bounce webhook (optional) -----------------------------------------------
# Add `--bounce-webhook` to the api command to serve
#   POST /v1/notifications/bounces/{tenantId}/{ses|twilio}
# which records provider bounces and complaints as suppressions, so a dead
# mailbox stops receiving mail (ADR-0302). Under 32 characters refuses to serve
# the route at all: anyone who guesses it can silence a tenant's mail.
#
# This verifies the *platform's own* HMAC, not the provider's. Whatever terminates
# the SNS or Twilio callback must re-sign the byte-identical body with
# `signWebhookPayload`, under the per-tenant key
#   HMAC-SHA256(NOTIFICATION_BOUNCE_SECRET, "bounce-webhook:" + tenantId)
# so a signature captured for one tenant cannot be replayed against another.
#NOTIFICATION_BOUNCE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
